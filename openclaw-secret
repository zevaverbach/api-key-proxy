#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# openclaw-secret — manage API key secrets across Beelink + Mac
#
# On Linux (Beelink): proxy routes + gateway injection + openclaw.json updates
# On macOS: stores in Keychain + updates pi models.json
#
# Install: ./install.sh (symlinks to ~/.local/bin)
# ---------------------------------------------------------------------------

REPO_DIR="${OPENCLAW_SECRET_REPO:-$HOME/repos/api-key-proxy}"
ROUTES_FILE="$REPO_DIR/routes.json"
GATEWAY_WRAPPER="$HOME/.local/bin/openclaw-gateway-start.sh"
OPENCLAW_CONFIG="$HOME/.openclaw/openclaw.json"
PI_MODELS="$HOME/.pi/agent/models.json"
OS="$(uname -s)"

# BWS config
BWS_SERVER="${BWS_SERVER:-https://vault.bitwarden.eu}"
BWS_PROJECT_ID="${BWS_PROJECT_ID:-28cd2389-0916-49fe-b1c6-b402007595fd}"

if [ "$OS" = "Darwin" ]; then
  BWS="${BWS:-$(command -v bws 2>/dev/null || echo /usr/local/bin/bws)}"
else
  BWS="${BWS:-$HOME/.local/bin/bws}"
fi

load_bws_token() {
  if [ -z "${BWS_ACCESS_TOKEN:-}" ]; then
    if [ "$OS" = "Darwin" ]; then
      BWS_ACCESS_TOKEN=$(security find-generic-password -s bws-access-token -w 2>/dev/null || true)
    fi
    if [ -z "${BWS_ACCESS_TOKEN:-}" ]; then
      local token_file="$HOME/.config/bws/access-token"
      if [ -f "$token_file" ]; then
        BWS_ACCESS_TOKEN=$(cat "$token_file")
      else
        echo "Error: No BWS access token found" >&2
        echo "  macOS: security add-generic-password -a bws -s bws-access-token -w 'TOKEN'" >&2
        echo "  Linux: echo 'TOKEN' > ~/.config/bws/access-token && chmod 600 ~/.config/bws/access-token" >&2
        exit 1
      fi
    fi
    export BWS_ACCESS_TOKEN
  fi
}

py_json() {
  python3 -c "import sys,json; $1"
}

usage() {
  cat <<EOF
Usage: openclaw-secret <command> [options]

Commands:
  add       Add a new secret
  remove    Remove a secret
  list      List current secrets/routes
  restart   Restart services (Beelink only)

add options:
  --name <name>          Label (e.g. "anthropic")
  --env <VAR_NAME>       Environment variable name for the key
  --value <secret>       The API key value (stored in Bitwarden)

  Proxied (default, Beelink only):
  --port <port>          Local proxy port
  --upstream <url>       Target API base URL

  Flags:
  --no-proxy             Inject directly into gateway env (Beelink)
  --provider <name>      Auto-update openclaw.json models.providers.<name>
  --skill <name>         Auto-update openclaw.json skills.entries.<name>
  --beelink              Run on Beelink via SSH (from Mac)

remove options:
  --name <name>          Secret to remove
  --delete-secret        Also delete from Bitwarden

Examples:
  # Proxied LLM key on Beelink (hidden from agent)
  openclaw-secret add --name anthropic --port 18794 \\
    --upstream https://api.anthropic.com \\
    --env ANTHROPIC_API_KEY --value "sk-ant-..." \\
    --provider anthropic

  # Non-proxied skill key on Beelink
  openclaw-secret add --name my-skill \\
    --env MY_SKILL_KEY --value "key123" \\
    --no-proxy --skill my-skill

  # LLM key on Mac (Keychain + pi models.json)
  openclaw-secret add --name anthropic \\
    --env ANTHROPIC_API_KEY --value "sk-ant-..."

  # Run on Beelink from Mac
  openclaw-secret add --beelink --name anthropic ...

  openclaw-secret list
  openclaw-secret restart
EOF
}

# ---------------------------------------------------------------------------
# openclaw.json helpers
# ---------------------------------------------------------------------------

update_openclaw_provider() {
  local provider="$1" port="$2" config="$3"

  python3 << PYEOF
import json

with open("$config") as f:
    c = json.load(f)

providers = c.setdefault("models", {}).setdefault("providers", {})
if "$provider" in providers:
    providers["$provider"]["baseUrl"] = "http://127.0.0.1:$port/v1"
    providers["$provider"]["apiKey"] = "not-needed"
else:
    providers["$provider"] = {
        "baseUrl": "http://127.0.0.1:$port/v1",
        "apiKey": "not-needed",
        "api": "openai-completions",
        "models": []
    }

with open("$config", "w") as f:
    json.dump(c, f, indent=2)

print("  ✓ Updated $config: models.providers.$provider")
print("    baseUrl = http://127.0.0.1:$port/v1")
print("    apiKey = not-needed")
PYEOF
}

update_openclaw_skill() {
  local skill="$1" env_var="$2" config="$3" port="${4:-}"

  python3 << PYEOF
import json

with open("$config") as f:
    c = json.load(f)

entry = c.setdefault("skills", {}).setdefault("entries", {}).setdefault("$skill", {})

if "$port":
    entry["apiKey"] = "proxy-handled"
    entry.setdefault("env", {})["OPENAI_BASE_URL"] = "http://127.0.0.1:$port/v1"
    print("  ✓ Updated $config: skills.entries.$skill")
    print("    apiKey = proxy-handled")
    print("    env.OPENAI_BASE_URL = http://127.0.0.1:$port/v1")
else:
    entry["apiKey"] = "\${$env_var}"
    print("  ✓ Updated $config: skills.entries.$skill")
    print('    apiKey = \${$env_var}')

with open("$config", "w") as f:
    json.dump(c, f, indent=2)
PYEOF
}

# ---------------------------------------------------------------------------
# macOS: Keychain + pi models.json
# ---------------------------------------------------------------------------

mac_store_key() {
  local env_var="$1" value="$2"

  # Delete existing if present, then add
  security delete-generic-password -s "$env_var" 2>/dev/null || true
  security add-generic-password -a "$env_var" -s "$env_var" -w "$value"
  echo "  ✓ Stored in macOS Keychain as '$env_var'"
}

mac_update_pi_models() {
  local provider="$1" env_var="$2" upstream="$3"

  python3 << PYEOF
import json, os

path = os.path.expanduser("$PI_MODELS")
try:
    with open(path) as f:
        config = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    config = {"providers": {}}

providers = config.setdefault("providers", {})
if "$provider" in providers:
    providers["$provider"]["apiKey"] = "!security find-generic-password -s $env_var -w"
    if "$upstream":
        providers["$provider"]["baseUrl"] = "$upstream"
else:
    providers["$provider"] = {
        "baseUrl": "$upstream" or "https://api.example.com/v1",
        "api": "openai-completions",
        "apiKey": "!security find-generic-password -s $env_var -w",
        "models": []
    }

with open(path, "w") as f:
    json.dump(config, f, indent=2)

print("  ✓ Updated $PI_MODELS: providers.$provider")
print("    apiKey = !security find-generic-password -s $env_var -w")
PYEOF
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_add() {
  local name="" port="" upstream="" env_var="" value="" no_proxy=false
  local provider="" skill="" use_beelink=false

  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)      name="$2";     shift 2;;
      --port)      port="$2";     shift 2;;
      --upstream)  upstream="$2"; shift 2;;
      --env)       env_var="$2";  shift 2;;
      --value)     value="$2";    shift 2;;
      --no-proxy)  no_proxy=true; shift;;
      --provider)  provider="$2"; shift 2;;
      --skill)     skill="$2";    shift 2;;
      --beelink)   use_beelink=true; shift;;
      *) echo "Unknown option: $1" >&2; exit 1;;
    esac
  done

  # Forward to Beelink via SSH
  if $use_beelink; then
    local args="add --name $name --env $env_var --value '$value'"
    [ -n "$port" ] && args="$args --port $port"
    [ -n "$upstream" ] && args="$args --upstream $upstream"
    [ -n "$provider" ] && args="$args --provider $provider"
    [ -n "$skill" ] && args="$args --skill $skill"
    $no_proxy && args="$args --no-proxy"
    ssh averbachs@100.113.119.55 "bash -l -c 'openclaw-secret $args'"
    return
  fi

  if [ -z "$name" ] || [ -z "$env_var" ] || [ -z "$value" ]; then
    echo "Error: --name, --env, and --value are required" >&2; exit 1
  fi

  # --- macOS path ---
  if [ "$OS" = "Darwin" ]; then
    echo "Adding secret on macOS..."

    # 1. Create in Bitwarden
    load_bws_token
    echo "Creating secret '$env_var' in Bitwarden..."
    local secret_out
    secret_out=$("$BWS" secret create "$env_var" "$value" "$BWS_PROJECT_ID" \
      --server-url "$BWS_SERVER" 2>&1) || {
      echo "Error creating secret: $secret_out" >&2; exit 1
    }
    local uuid
    uuid=$(echo "$secret_out" | py_json "print(json.load(sys.stdin)['id'])")
    echo "  ✓ Created in Bitwarden: $env_var (UUID: $uuid)"

    # 2. Store in Keychain
    mac_store_key "$env_var" "$value"

    # 3. Update pi models.json if --provider given
    if [ -n "$provider" ]; then
      mac_update_pi_models "$provider" "$env_var" "${upstream:-}"
    fi

    echo ""
    echo "Done. Key available to pi via: !security find-generic-password -s $env_var -w"
    return
  fi

  # --- Linux (Beelink) path ---

  if ! $no_proxy && { [ -z "$port" ] || [ -z "$upstream" ]; }; then
    echo "Error: --port and --upstream required for proxied keys (or use --no-proxy)" >&2; exit 1
  fi

  # Check for duplicate route (proxied only)
  if ! $no_proxy; then
    local dup
    dup=$(py_json "
routes = json.load(open('$ROUTES_FILE'))
for r in routes:
    if r['name'] == '$name': print('name')
    if r['port'] == $port: print('port')
    ")
    if echo "$dup" | grep -q "name"; then
      echo "Error: route '$name' already exists" >&2; exit 1
    fi
    if echo "$dup" | grep -q "port"; then
      echo "Error: port $port already in use" >&2; exit 1
    fi
  fi

  # 1. Create secret in Bitwarden
  load_bws_token
  echo "Creating secret '$env_var' in Bitwarden..."
  local secret_out
  secret_out=$("$BWS" secret create "$env_var" "$value" "$BWS_PROJECT_ID" \
    --server-url "$BWS_SERVER" 2>&1) || {
    echo "Error creating secret: $secret_out" >&2; exit 1
  }
  local uuid
  uuid=$(echo "$secret_out" | py_json "print(json.load(sys.stdin)['id'])")
  echo "  ✓ Created: $env_var (UUID: $uuid)"

  if $no_proxy; then
    # 2a. Add to gateway wrapper
    echo "Adding to gateway wrapper..."
    local export_line="export ${env_var}=\$(get_secret ${uuid})"
    if grep -q "$env_var" "$GATEWAY_WRAPPER" 2>/dev/null; then
      echo "  Warning: $env_var already in gateway wrapper, skipping" >&2
    else
      sed -i "/^unset BWS_ACCESS_TOKEN/i ${export_line}" "$GATEWAY_WRAPPER"
      echo "  ✓ Added to $GATEWAY_WRAPPER"
    fi

    # 3a. Update openclaw.json
    if [ -n "$skill" ]; then
      update_openclaw_skill "$skill" "$env_var" "$OPENCLAW_CONFIG"
    elif [ -n "$provider" ]; then
      update_openclaw_provider "$provider" "" "$OPENCLAW_CONFIG"
    fi

    # 4a. Restart gateway
    echo "Restarting gateway..."
    systemctl --user restart openclaw-gateway.service 2>/dev/null && echo "  ✓ Done." || echo "  (restart manually)"

  else
    # 2b. Add route
    py_json "
routes = json.load(open('$ROUTES_FILE'))
routes.append({
    'name': '$name',
    'port': $port,
    'upstream': '$upstream',
    'keyEnv': '$env_var'
})
json.dump(routes, open('$ROUTES_FILE', 'w'), indent=2)
print('  ✓ Added route: $name :$port -> $upstream')
    "

    # 3b. Update openclaw.json
    if [ -n "$provider" ]; then
      update_openclaw_provider "$provider" "$port" "$OPENCLAW_CONFIG"
    fi
    if [ -n "$skill" ]; then
      update_openclaw_skill "$skill" "$env_var" "$OPENCLAW_CONFIG" "$port"
    fi

    # 4b. Restart proxy + gateway
    echo "Restarting services..."
    systemctl --user restart api-key-proxy.service 2>/dev/null && echo "  ✓ Proxy restarted." || true
    systemctl --user restart openclaw-gateway.service 2>/dev/null && echo "  ✓ Gateway restarted." || true
  fi

  echo ""
  echo "Done."
}

cmd_remove() {
  local name="" delete_secret=false

  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)          name="$2"; shift 2;;
      --delete-secret) delete_secret=true; shift;;
      *) echo "Unknown option: $1" >&2; exit 1;;
    esac
  done

  if [ -z "$name" ]; then
    echo "Error: --name required" >&2; exit 1
  fi

  # Try removing from routes (proxied)
  if [ "$OS" != "Darwin" ] && [ -f "$ROUTES_FILE" ]; then
    local key_env
    key_env=$(py_json "
routes = json.load(open('$ROUTES_FILE'))
found = [r for r in routes if r['name'] == '$name']
if found:
    print(found[0]['keyEnv'])
    routes = [r for r in routes if r['name'] != '$name']
    json.dump(routes, open('$ROUTES_FILE', 'w'), indent=2)
else:
    print('NOT_FOUND')
    ")

    if [ "$key_env" != "NOT_FOUND" ]; then
      echo "Removed proxy route '$name' ($key_env)"
      systemctl --user restart api-key-proxy.service 2>/dev/null && echo "  ✓ Proxy restarted." || true
    else
      echo "No proxy route named '$name'."
    fi
  fi

  if [ "$OS" = "Darwin" ]; then
    echo "To remove from Keychain: security delete-generic-password -s <ENV_VAR>"
  fi

  if $delete_secret; then
    load_bws_token
    echo "Searching Bitwarden for secrets matching '$name'..."
    "$BWS" secret list "$BWS_PROJECT_ID" --server-url "$BWS_SERVER" 2>/dev/null \
      | py_json "
secrets = json.load(sys.stdin)
for s in secrets:
    if '$name'.upper().replace('-','_') in s['key'] or '$name' in s['key'].lower():
        print(f\"  Found: {s['key']} ({s['id']})\")" || true
    echo "  Delete manually: bws secret delete <UUID> --server-url $BWS_SERVER"
  fi
}

cmd_list() {
  if [ "$OS" != "Darwin" ] && [ -f "$ROUTES_FILE" ]; then
    echo "Proxied routes (Beelink):"
    py_json "
routes = json.load(open('$ROUTES_FILE'))
if not routes:
    print('  (none)')
else:
    for r in routes:
        print(f\"  {r['name']:15s} :{r['port']}  ->  {r['upstream']:40s}  key: {r['keyEnv']}\")
    "
    echo ""
    echo "Gateway-injected secrets:"
    grep 'export.*get_secret' "$GATEWAY_WRAPPER" 2>/dev/null | sed 's/^/  /' || echo "  (none)"
  fi

  if [ "$OS" = "Darwin" ] && [ -f "$PI_MODELS" ]; then
    echo "Pi models.json providers:"
    py_json "
c = json.load(open('$PI_MODELS'))
for name, p in c.get('providers', {}).items():
    key = p.get('apiKey', '?')
    url = p.get('baseUrl', '?')
    print(f'  {name:15s}  {url:45s}  key: {key}')
    " 2>/dev/null || echo "  (none)"
  fi

  echo ""
  echo "Bitwarden secrets (OpenClaw project):"
  load_bws_token
  "$BWS" secret list "$BWS_PROJECT_ID" --server-url "$BWS_SERVER" 2>/dev/null \
    | py_json "
for s in json.load(sys.stdin):
    print(f\"  {s['key']:30s}  {s['id']}\")" 2>/dev/null || echo "  (could not list — check bws token)"
}

cmd_restart() {
  if [ "$OS" = "Darwin" ]; then
    echo "Nothing to restart on macOS — pi reads keys from Keychain on demand."
    return
  fi
  echo "Restarting api-key-proxy + openclaw-gateway..."
  systemctl --user restart api-key-proxy.service openclaw-gateway.service
  echo "✓ Done."
}

# ---------------------------------------------------------------------------
if [ $# -lt 1 ]; then usage; exit 1; fi
cmd="$1"; shift
case "$cmd" in
  add)     cmd_add "$@";;
  remove)  cmd_remove "$@";;
  list)    cmd_list;;
  restart) cmd_restart;;
  help|-h|--help) usage;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 1;;
esac
