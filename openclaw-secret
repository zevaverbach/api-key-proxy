#!/bin/bash
set -euo pipefail

# ---------------------------------------------------------------------------
# openclaw-secret — manage API key secrets across Beelink + Mac
#
# On Linux (Beelink): proxy routes + gateway injection + openclaw.json updates
# On macOS: stores in Keychain + updates pi models.json
#
# Install: ./install.sh (symlinks to ~/.local/bin)
# ---------------------------------------------------------------------------

REPO_DIR="${OPENCLAW_SECRET_REPO:-$HOME/repos/api-key-proxy}"
ROUTES_FILE="$REPO_DIR/routes.json"
GATEWAY_WRAPPER="$HOME/.local/bin/openclaw-gateway-start.sh"
OPENCLAW_CONFIG="$HOME/.openclaw/openclaw.json"
PI_MODELS="$HOME/.pi/agent/models.json"
OS="$(uname -s)"
BASE_PROXY_PORT=18792

BWS_SERVER="${BWS_SERVER:-https://vault.bitwarden.eu}"
BWS_PROJECT_ID="${BWS_PROJECT_ID:-28cd2389-0916-49fe-b1c6-b402007595fd}"

if [ "$OS" = "Darwin" ]; then
  BWS="${BWS:-$(command -v bws 2>/dev/null || echo /usr/local/bin/bws)}"
else
  BWS="${BWS:-$HOME/.local/bin/bws}"
fi

load_bws_token() {
  if [ -z "${BWS_ACCESS_TOKEN:-}" ]; then
    if [ "$OS" = "Darwin" ]; then
      BWS_ACCESS_TOKEN=$(security find-generic-password -s bws-access-token -w 2>/dev/null || true)
    fi
    if [ -z "${BWS_ACCESS_TOKEN:-}" ]; then
      local token_file="$HOME/.config/bws/access-token"
      if [ -f "$token_file" ]; then
        BWS_ACCESS_TOKEN=$(cat "$token_file")
      else
        echo "Error: No BWS access token found" >&2
        echo "  macOS: security add-generic-password -a bws -s bws-access-token -w 'TOKEN'" >&2
        echo "  Linux: echo 'TOKEN' > ~/.config/bws/access-token && chmod 600 ~/.config/bws/access-token" >&2
        exit 1
      fi
    fi
    export BWS_ACCESS_TOKEN
  fi
}

py_json() {
  python3 -c "import sys,json; $1"
}

# Auto-assign next available port from routes.json
next_port() {
  py_json "
routes = json.load(open('$ROUTES_FILE'))
used = {r['port'] for r in routes}
port = $BASE_PROXY_PORT
while port in used:
    port += 1
print(port)
  "
}

usage() {
  cat <<EOF
Usage: openclaw-secret <command> [options]

Commands:
  add       Add a new API key secret
  rotate    Update an existing secret's value
  remove    Remove a secret
  list      List all secrets
  restart   Restart services (Beelink only)

add options:
  --name <name>          Provider/label (e.g. "anthropic"). Also used as the
                         provider name in openclaw.json / pi models.json.
  --env <VAR_NAME>       Environment variable name (e.g. ANTHROPIC_API_KEY)
  --value <secret>       The API key
  --upstream <url>       Target API base URL (e.g. https://api.anthropic.com)

  Flags:
  --no-proxy             Don't proxy; inject directly into gateway env (Beelink)
  --skill <name>         Target a skill entry in openclaw.json instead of a provider
  --port <port>          Override auto-assigned proxy port
  --beelink              Run on Beelink via SSH (from Mac)

remove options:
  --name <name>          Secret to remove
  --delete-secret        Also delete from Bitwarden

Examples:
  # Proxied LLM key on Beelink (port auto-assigned, openclaw.json auto-updated)
  openclaw-secret add --name anthropic \\
    --upstream https://api.anthropic.com \\
    --env ANTHROPIC_API_KEY --value "sk-ant-..."

  # Non-proxied skill key on Beelink
  openclaw-secret add --name my-skill \\
    --env MY_SKILL_KEY --value "key123" \\
    --no-proxy --skill my-skill

  # LLM key on Mac (Keychain + pi models.json)
  openclaw-secret add --name moonshot \\
    --env MOONSHOT_API_KEY --value "sk-..." \\
    --upstream https://api.moonshot.ai/v1

  # Run on Beelink from Mac
  openclaw-secret add --beelink --name anthropic \\
    --upstream https://api.anthropic.com \\
    --env ANTHROPIC_API_KEY --value "sk-ant-..."

  # Rotate a key (fuzzy matches name to Bitwarden secret)
  openclaw-secret rotate --name moonshot --value "sk-new-..."

  openclaw-secret list
  openclaw-secret restart
EOF
}

# ---------------------------------------------------------------------------
# openclaw.json / pi models.json helpers
# ---------------------------------------------------------------------------

update_openclaw_provider() {
  local provider="$1" port="$2" config="$3"
  python3 << PYEOF
import json
with open("$config") as f:
    c = json.load(f)
p = c.setdefault("models", {}).setdefault("providers", {})
if "$provider" in p:
    p["$provider"]["baseUrl"] = "http://127.0.0.1:$port/v1"
    p["$provider"]["apiKey"] = "not-needed"
else:
    p["$provider"] = {
        "baseUrl": "http://127.0.0.1:$port/v1",
        "apiKey": "not-needed",
        "api": "openai-completions",
        "models": []
    }
with open("$config", "w") as f:
    json.dump(c, f, indent=2)
print("  ✓ openclaw.json: models.providers.$provider -> :$port")
PYEOF
}

update_openclaw_skill() {
  local skill="$1" env_var="$2" config="$3" port="${4:-}"
  python3 << PYEOF
import json
with open("$config") as f:
    c = json.load(f)
entry = c.setdefault("skills", {}).setdefault("entries", {}).setdefault("$skill", {})
if "$port":
    entry["apiKey"] = "proxy-handled"
    entry.setdefault("env", {})["OPENAI_BASE_URL"] = "http://127.0.0.1:$port/v1"
    print("  ✓ openclaw.json: skills.$skill -> proxy :$port")
else:
    entry["apiKey"] = "\${$env_var}"
    print("  ✓ openclaw.json: skills.$skill -> \${$env_var}")
with open("$config", "w") as f:
    json.dump(c, f, indent=2)
PYEOF
}

mac_store_key() {
  local env_var="$1" value="$2"
  security delete-generic-password -s "$env_var" 2>/dev/null || true
  security add-generic-password -a "$env_var" -s "$env_var" -w "$value"
  echo "  ✓ macOS Keychain: $env_var"
}

mac_update_pi_models() {
  local provider="$1" env_var="$2" upstream="$3"
  python3 << PYEOF
import json, os
path = os.path.expanduser("$PI_MODELS")
try:
    with open(path) as f:
        config = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    config = {"providers": {}}
p = config.setdefault("providers", {})
if "$provider" in p:
    p["$provider"]["apiKey"] = "!security find-generic-password -s $env_var -w"
    if "$upstream":
        p["$provider"]["baseUrl"] = "$upstream"
else:
    p["$provider"] = {
        "baseUrl": "${upstream:-https://api.example.com/v1}",
        "api": "openai-completions",
        "apiKey": "!security find-generic-password -s $env_var -w",
        "models": []
    }
with open(path, "w") as f:
    json.dump(config, f, indent=2)
print("  ✓ pi models.json: providers.$provider (apiKey from Keychain)")
PYEOF
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_add() {
  local name="" port="" upstream="" env_var="" value="" no_proxy=false
  local skill="" use_beelink=false

  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)      name="$2";     shift 2;;
      --port)      port="$2";     shift 2;;
      --upstream)  upstream="$2"; shift 2;;
      --env)       env_var="$2";  shift 2;;
      --value)     value="$2";    shift 2;;
      --no-proxy)  no_proxy=true; shift;;
      --skill)     skill="$2";    shift 2;;
      --beelink)   use_beelink=true; shift;;
      # Accept --provider as alias for --name (backward compat)
      --provider)  name="$2";     shift 2;;
      *) echo "Unknown option: $1" >&2; exit 1;;
    esac
  done

  # Forward to Beelink via SSH
  if $use_beelink; then
    local args="add --name '$name' --env '$env_var' --value '$value'"
    [ -n "$port" ] && args="$args --port '$port'"
    [ -n "$upstream" ] && args="$args --upstream '$upstream'"
    [ -n "$skill" ] && args="$args --skill '$skill'"
    $no_proxy && args="$args --no-proxy"
    ssh averbachs@100.113.119.55 "bash -l -c 'openclaw-secret $args'"
    return
  fi

  if [ -z "$name" ] || [ -z "$env_var" ] || [ -z "$value" ]; then
    echo "Error: --name, --env, and --value are required" >&2; exit 1
  fi

  # --- macOS ---
  if [ "$OS" = "Darwin" ]; then
    echo "Adding secret on macOS..."
    load_bws_token

    echo "Creating '$env_var' in Bitwarden..."
    local secret_out uuid
    secret_out=$("$BWS" secret create "$env_var" "$value" "$BWS_PROJECT_ID" \
      --server-url "$BWS_SERVER" 2>&1) || {
      echo "Error: $secret_out" >&2; exit 1
    }
    uuid=$(echo "$secret_out" | py_json "print(json.load(sys.stdin)['id'])")
    echo "  ✓ Bitwarden: $env_var ($uuid)"

    mac_store_key "$env_var" "$value"

    if [ -n "$upstream" ] || [ -z "$skill" ]; then
      mac_update_pi_models "$name" "$env_var" "${upstream:-}"
    fi

    echo ""
    echo "Done. Available to pi via: !security find-generic-password -s $env_var -w"
    return
  fi

  # --- Linux (Beelink) ---

  # Auto-assign port if not specified (proxied mode)
  if ! $no_proxy; then
    if [ -z "$upstream" ]; then
      echo "Error: --upstream required for proxied keys (or use --no-proxy)" >&2; exit 1
    fi
    if [ -z "$port" ]; then
      port=$(next_port)
      echo "Auto-assigned port: $port"
    fi

    # Check duplicates
    local dup
    dup=$(py_json "
routes = json.load(open('$ROUTES_FILE'))
for r in routes:
    if r['name'] == '$name': print('name')
    if r['port'] == $port: print('port')
    ")
    if echo "$dup" | grep -q "name"; then
      echo "Error: route '$name' already exists" >&2; exit 1
    fi
    if echo "$dup" | grep -q "port"; then
      echo "Error: port $port already in use" >&2; exit 1
    fi
  fi

  # Create Bitwarden secret
  load_bws_token
  echo "Creating '$env_var' in Bitwarden..."
  local secret_out uuid
  secret_out=$("$BWS" secret create "$env_var" "$value" "$BWS_PROJECT_ID" \
    --server-url "$BWS_SERVER" 2>&1) || {
    echo "Error: $secret_out" >&2; exit 1
  }
  uuid=$(echo "$secret_out" | py_json "print(json.load(sys.stdin)['id'])")
  echo "  ✓ Bitwarden: $env_var ($uuid)"

  if $no_proxy; then
    # Add to gateway wrapper (before 'unset BWS_ACCESS_TOKEN')
    local export_line="export ${env_var}=\$(get_secret ${uuid})"
    if grep -q "$env_var" "$GATEWAY_WRAPPER" 2>/dev/null; then
      echo "  ⚠ $env_var already in gateway wrapper"
    else
      sed -i "/^unset BWS_ACCESS_TOKEN/i ${export_line}" "$GATEWAY_WRAPPER"
      echo "  ✓ Gateway wrapper: added $env_var"
    fi

    # Update openclaw.json
    if [ -n "$skill" ]; then
      update_openclaw_skill "$skill" "$env_var" "$OPENCLAW_CONFIG"
    fi

    echo "Restarting gateway..."
    systemctl --user restart openclaw-gateway.service 2>/dev/null && echo "  ✓ Gateway restarted." || true

  else
    # Add proxy route
    py_json "
routes = json.load(open('$ROUTES_FILE'))
routes.append({'name': '$name', 'port': $port, 'upstream': '$upstream', 'keyEnv': '$env_var'})
json.dump(routes, open('$ROUTES_FILE', 'w'), indent=2)
print('  ✓ Route: $name :$port -> $upstream')
    "

    # Update openclaw.json
    if [ -n "$skill" ]; then
      update_openclaw_skill "$skill" "$env_var" "$OPENCLAW_CONFIG" "$port"
    else
      update_openclaw_provider "$name" "$port" "$OPENCLAW_CONFIG"
    fi

    echo "Restarting services..."
    systemctl --user restart api-key-proxy.service 2>/dev/null && echo "  ✓ Proxy restarted." || true
    systemctl --user restart openclaw-gateway.service 2>/dev/null && echo "  ✓ Gateway restarted." || true
  fi

  echo ""
  echo "Done."
}

cmd_remove() {
  local name="" delete_secret=false

  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)          name="$2"; shift 2;;
      --delete-secret) delete_secret=true; shift;;
      *) echo "Unknown option: $1" >&2; exit 1;;
    esac
  done

  [ -z "$name" ] && { echo "Error: --name required" >&2; exit 1; }

  if [ "$OS" != "Darwin" ] && [ -f "$ROUTES_FILE" ]; then
    local key_env
    key_env=$(py_json "
routes = json.load(open('$ROUTES_FILE'))
found = [r for r in routes if r['name'] == '$name']
if found:
    print(found[0]['keyEnv'])
    routes = [r for r in routes if r['name'] != '$name']
    json.dump(routes, open('$ROUTES_FILE', 'w'), indent=2)
else:
    print('NOT_FOUND')
    ")
    if [ "$key_env" != "NOT_FOUND" ]; then
      echo "Removed proxy route '$name' ($key_env)"
      systemctl --user restart api-key-proxy.service 2>/dev/null && echo "  ✓ Proxy restarted." || true
    else
      echo "No proxy route named '$name'."
    fi
  fi

  if [ "$OS" = "Darwin" ]; then
    echo "To remove from Keychain: security delete-generic-password -s <ENV_VAR>"
  fi

  if $delete_secret; then
    load_bws_token
    "$BWS" secret list "$BWS_PROJECT_ID" --server-url "$BWS_SERVER" 2>/dev/null \
      | py_json "
secrets = json.load(sys.stdin)
for s in secrets:
    if '$name'.upper().replace('-','_') in s['key'] or '$name' in s['key'].lower():
        print(f\"  Found: {s['key']} ({s['id']})\")" || true
    echo "  Delete manually: bws secret delete <UUID> --server-url $BWS_SERVER"
  fi
}

cmd_list() {
  if [ "$OS" != "Darwin" ] && [ -f "$ROUTES_FILE" ]; then
    echo "Proxied routes:"
    py_json "
routes = json.load(open('$ROUTES_FILE'))
if not routes:
    print('  (none)')
else:
    for r in routes:
        print(f\"  {r['name']:15s} :{r['port']}  ->  {r['upstream']:40s}  key: {r['keyEnv']}\")
    "
    echo ""
    echo "Gateway-injected (non-proxied):"
    grep 'export.*get_secret' "$GATEWAY_WRAPPER" 2>/dev/null | sed 's/^/  /' || echo "  (none)"
  fi

  if [ "$OS" = "Darwin" ] && [ -f "$PI_MODELS" ]; then
    echo "Pi models.json:"
    py_json "
c = json.load(open('$PI_MODELS'))
for name, p in c.get('providers', {}).items():
    print(f\"  {name:15s}  {p.get('baseUrl','?'):45s}  key: {p.get('apiKey','?')}\")
    " 2>/dev/null || echo "  (none)"
  fi

  echo ""
  echo "Bitwarden (OpenClaw project):"
  load_bws_token
  "$BWS" secret list "$BWS_PROJECT_ID" --server-url "$BWS_SERVER" 2>/dev/null \
    | py_json "
for s in json.load(sys.stdin):
    print(f\"  {s['key']:30s}  {s['id']}\")" 2>/dev/null || echo "  (check bws token)"
}

cmd_rotate() {
  local name="" value=""

  while [[ $# -gt 0 ]]; do
    case $1 in
      --name)  name="$2";  shift 2;;
      --value) value="$2"; shift 2;;
      *) echo "Unknown option: $1" >&2; exit 1;;
    esac
  done

  if [ -z "$name" ] || [ -z "$value" ]; then
    echo "Usage: openclaw-secret rotate --name <name> --value <new-key>" >&2; exit 1
  fi

  load_bws_token

  # Find the secret by matching name against route names, env var names, or key names
  local match
  match=$("$BWS" secret list "$BWS_PROJECT_ID" --server-url "$BWS_SERVER" 2>/dev/null \
    | py_json "
secrets = json.load(sys.stdin)
name = '$name'
# Try exact key match, then case-insensitive, then route-name-style match
for s in secrets:
    if s['key'] == name or s['key'] == name.upper() or s['key'] == name.upper().replace('-','_') + '_API_KEY':
        print(s['id'] + ' ' + s['key'])
        break
else:
    # Try substring
    for s in secrets:
        if name.lower() in s['key'].lower():
            print(s['id'] + ' ' + s['key'])
            break
    else:
        print('NOT_FOUND')
  ")

  if [ "$match" = "NOT_FOUND" ]; then
    echo "Error: no secret matching '$name' found in Bitwarden" >&2
    echo "Available secrets:" >&2
    "$BWS" secret list "$BWS_PROJECT_ID" --server-url "$BWS_SERVER" 2>/dev/null \
      | py_json "
for s in json.load(sys.stdin):
    print(f'  {s[\"key\"]}')" >&2
    exit 1
  fi

  local uuid="${match%% *}"
  local key_name="${match#* }"

  # 1. Update in Bitwarden
  "$BWS" secret edit "$uuid" --value "$value" --server-url "$BWS_SERVER" >/dev/null 2>&1
  echo "✓ Bitwarden: updated $key_name"

  # 2. Update macOS Keychain if on Mac
  if [ "$OS" = "Darwin" ]; then
    security delete-generic-password -s "$key_name" 2>/dev/null || true
    security add-generic-password -a "$key_name" -s "$key_name" -w "$value"
    echo "✓ Keychain: updated $key_name"
  fi

  # 3. Restart services (Linux only)
  if [ "$OS" != "Darwin" ]; then
    echo "Restarting services..."
    systemctl --user restart api-key-proxy.service openclaw-gateway.service 2>/dev/null \
      && echo "✓ Services restarted." || echo "  (restart manually)"
  fi

  echo ""
  echo "Done. $key_name rotated."
}

cmd_restart() {
  if [ "$OS" = "Darwin" ]; then
    echo "Nothing to restart on macOS — pi reads keys from Keychain on demand."
    return
  fi
  echo "Restarting api-key-proxy + openclaw-gateway..."
  systemctl --user restart api-key-proxy.service openclaw-gateway.service
  echo "✓ Done."
}

# ---------------------------------------------------------------------------
if [ $# -lt 1 ]; then usage; exit 1; fi
cmd="$1"; shift
case "$cmd" in
  add)     cmd_add "$@";;
  remove)  cmd_remove "$@";;
  rotate)  cmd_rotate "$@";;
  list)    cmd_list;;
  restart) cmd_restart;;
  help|-h|--help) usage;;
  *) echo "Unknown command: $cmd" >&2; usage; exit 1;;
esac
